---
import { portfolioData } from '../data/portfolio';

const { experiences } = portfolioData;
---

<section class="experience" id="experiencia" aria-labelledby="experience-heading">
  <h2 class="section-heading" id="experience-heading">Experiencia</h2>
  {experiences.map((experience) => (
    <article class:list={['career-row', { 'current-job': experience.current }]}>
      <header class="career-header">
        <div>
          <h3 class="company">{experience.company}</h3>
          <p class="job-role">{experience.role}</p>
        </div>
        <p class="period">{experience.period}</p>
      </header>
      <div class="career-content">
        <p class="contribution">{experience.summary}</p>
        <dl class="job-technologies" aria-label={`Tecnologías aplicadas en ${experience.company}`}>
          {experience.technologies.map((technology) => (
            <div><dt>{technology.area}:</dt>{' '}<dd>{technology.items}</dd></div>
          ))}
        </dl>
        <details>
          <summary>Responsabilidades en {experience.company}</summary>
          <div class="detail-body">
            <ul>
              {experience.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </div>
        </details>
        {experience.project && (
          <details class="case-study" id="caso-periferia">
            <summary>Proyecto: {experience.project.shortTitle}</summary>
            <div class="detail-body">
              <h4>{experience.project.title}</h4>
              <p class="case-context">{experience.project.context}</p>
              <div class="case-content">
                <div>
                  <p>{experience.project.summary}</p>
                  <p class="case-outcome">{experience.project.outcome}</p>
                  <p class="case-tools">Tecnologías del proyecto: {experience.project.technologies}</p>
                </div>
                <ul>
                  {experience.project.details.map((detail) => <li>{detail}</li>)}
                </ul>
              </div>
            </div>
          </details>
        )}
      </div>
    </article>
  ))}
</section>
