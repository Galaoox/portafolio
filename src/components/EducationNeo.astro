---
import { portfolioData } from '../data/portfolio';

const { education, institution } = portfolioData;
---

<section id="formacion" aria-labelledby="education-heading">
  <h2 id="education-heading">Formación</h2>
  <p class="institution">{institution}</p>
  <ul class="education-list">
    {education.map((entry) => (
      <li>
        <h3>{entry.degree}</h3>
        <p>{entry.period}</p>
      </li>
    ))}
  </ul>
</section>
