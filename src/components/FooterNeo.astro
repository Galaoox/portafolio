---
import { portfolioData } from '../data/portfolio';

const { personal, contact } = portfolioData;
---

<footer class="contact wrap" id="contacto" aria-labelledby="contact-heading">
  <div class="contact-grid">
    <h2 id="contact-heading">{contact.title}</h2>
    <div>
      <p>{contact.text}</p>
      <a class="contact-primary" href={personal.linkedin}>Escríbeme por LinkedIn</a>
      <div class="contact-links">
        <a href={personal.github}>GitHub</a>
      </div>
    </div>
  </div>
  <div class="closing">
    <p>{personal.name} · {personal.location}</p>
    <a href="#inicio">Volver al inicio</a>
  </div>
</footer>
