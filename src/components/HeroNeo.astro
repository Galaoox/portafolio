---
import { portfolioData } from '../data/portfolio';

const { personal } = portfolioData;
---

<header class="hero wrap" id="inicio">
  <div class="name-row">
    <h1>{personal.name}</h1>
    <p class="location">{personal.location}</p>
  </div>
  <div class="intro-grid">
    <div>
      <p class="role">{personal.role}</p>
      <p class="current">{personal.current}</p>
    </div>
    <div>
      <p class="intro">{personal.intro}</p>
      <div class="intro-links">
        <a href={personal.linkedin}>Escríbeme por LinkedIn</a>
        <a href={personal.github}>GitHub</a>
      </div>
    </div>
  </div>
  <nav class="section-nav" aria-label="Navegación del portafolio">
    <a href="#experiencia">Experiencia</a>
    <a href="#capacidades">Capacidades</a>
    <a href="#formacion">Formación</a>
    <a href="#contacto">Contacto</a>
  </nav>
</header>
