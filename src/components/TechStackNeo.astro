---
import { portfolioData } from '../data/portfolio';

const { skills } = portfolioData;
---

<section id="capacidades" aria-labelledby="skills-heading">
  <h2 id="skills-heading">Capacidades</h2>
  <dl>
    {skills.map((skill) => (
      <div class="skill">
        <dt>{skill.name}</dt>
        <dd>{skill.items}</dd>
      </div>
    ))}
  </dl>
</section>
